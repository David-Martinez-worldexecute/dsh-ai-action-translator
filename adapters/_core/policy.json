{
  "$comment": "GENERATED by tools/build-policy.mjs from lib/guard.js — 不要手改。",
  "schema": 1,
  "modes": [
    "off",
    "warn",
    "deny"
  ],
  "levels": [
    "high",
    "medium"
  ],
  "skipTools": [
    "read",
    "glob",
    "grep",
    "rg",
    "ls",
    "cat",
    "decompress",
    "search_context",
    "acp_status",
    "retrieve_spill",
    "list_agents",
    "job_list",
    "job_output"
  ],
  "rules": [
    {
      "id": "delete-recursive",
      "level": "high",
      "label": "递归删除",
      "labelEn": "Recursive delete",
      "zh": "这条命令会把整个目录连同里面的东西一起删掉，而且通常不进回收站。",
      "en": "This removes a whole directory tree, and usually not into the recycle bin.",
      "patterns": [
        {
          "source": "\\brm\\s+(-[a-z]*r[a-z]*f|-[a-z]*f[a-z]*r)\\b",
          "flags": "i"
        },
        {
          "source": "\\brm\\s+-[a-z]*r\\b",
          "flags": "i"
        },
        {
          "source": "\\brmdir\\s+\\/s\\b",
          "flags": "i"
        },
        {
          "source": "\\brd\\s+\\/s\\b",
          "flags": "i"
        },
        {
          "source": "\\bdel\\s+(\\/[a-z]\\s*)*\\/s\\b",
          "flags": "i"
        },
        {
          "source": "\\bRemove-Item\\b[^\\n]*-Recurse",
          "flags": "i"
        },
        {
          "source": "\\bRemove-Item\\b[^\\n]*-Force[^\\n]*\\*",
          "flags": "i"
        },
        {
          "source": "\\bClear-Content\\b",
          "flags": "i"
        }
      ]
    },
    {
      "id": "system-power",
      "level": "high",
      "label": "关机 / 重启 / 磁盘级操作",
      "labelEn": "Power, boot, or disk-level operation",
      "zh": "这会动到整台机器（关机、改启动项、分区或格式化），不只是这个项目。",
      "en": "This touches the whole machine (power, boot entries, partitions, or formatting), not just this project.",
      "patterns": [
        {
          "source": "\\bshutdown\\b",
          "flags": "i"
        },
        {
          "source": "\\bRestart-Computer\\b",
          "flags": "i"
        },
        {
          "source": "\\bStop-Computer\\b",
          "flags": "i"
        },
        {
          "source": "\\bpoweroff\\b",
          "flags": "i"
        },
        {
          "source": "\\breboot\\b",
          "flags": "i"
        },
        {
          "source": "\\bbcdedit\\b",
          "flags": "i"
        },
        {
          "source": "\\bdiskpart\\b",
          "flags": "i"
        },
        {
          "source": "\\bFormat-Volume\\b",
          "flags": "i"
        },
        {
          "source": "\\bformat\\s+[a-z]:",
          "flags": "i"
        },
        {
          "source": "\\bmkfs(\\.\\w+)?\\b",
          "flags": "i"
        }
      ]
    },
    {
      "id": "permission-change",
      "level": "high",
      "label": "权限 / 安全策略变更",
      "labelEn": "Permission or security-policy change",
      "zh": "这会改文件权限或执行策略，影响范围可能超出当前目录，而且事后很难全部还原。",
      "en": "This changes file permissions or execution policy. The effect can reach beyond this folder and is hard to fully undo.",
      "patterns": [
        {
          "source": "\\bicacls\\b",
          "flags": "i"
        },
        {
          "source": "\\btakeown\\b",
          "flags": "i"
        },
        {
          "source": "\\bcacls\\b",
          "flags": "i"
        },
        {
          "source": "\\bSet-ExecutionPolicy\\b",
          "flags": "i"
        },
        {
          "source": "\\bchmod\\s+[0-7]{3,4}\\b",
          "flags": "i"
        },
        {
          "source": "\\bchown\\b",
          "flags": "i"
        },
        {
          "source": "\\breg\\s+(add|delete)\\b[^\\n]*HK(LM|CR|U)\\b",
          "flags": "i"
        }
      ]
    },
    {
      "id": "credential-read",
      "level": "high",
      "label": "读取凭据 / 私钥",
      "labelEn": "Read credentials or private keys",
      "zh": "这个路径通常放的是密钥或令牌。读出来意味着它可能被写进日志、上下文或聊天记录。",
      "en": "This path usually holds keys or tokens. Reading it means it may end up in logs, context, or chat history.",
      "patterns": [
        {
          "source": "\\.ssh\\b",
          "flags": "i"
        },
        {
          "source": "\\.gnupg\\b",
          "flags": "i"
        },
        {
          "source": "\\bid_(rsa|ed25519|ecdsa)\\b",
          "flags": "i"
        },
        {
          "source": "\\.credentials\\.(yaml|yml|json)\\b",
          "flags": "i"
        },
        {
          "source": "credentials\\.json\\b",
          "flags": "i"
        },
        {
          "source": "\\.npmrc\\b",
          "flags": "i"
        },
        {
          "source": "\\.env(\\.local)?\\b",
          "flags": "i"
        },
        {
          "source": "\\.pypirc\\b",
          "flags": "i"
        },
        {
          "source": "secrets?\\.(json|ya?ml)\\b",
          "flags": "i"
        }
      ],
      "alwaysCheck": true
    },
    {
      "id": "git-destructive",
      "level": "high",
      "label": "破坏性 Git 操作",
      "labelEn": "Destructive git operation",
      "zh": "这会改写或丢弃已有提交 / 未提交的改动，本地能回滚，但已经推送出去就收不回来了。",
      "en": "This rewrites or discards commits or uncommitted work. Locally recoverable, but not once pushed.",
      "patterns": [
        {
          "source": "\\bgit\\s+push\\b[^\\n]*(--force|-f)\\b",
          "flags": "i"
        },
        {
          "source": "\\bgit\\s+reset\\b[^\\n]*--hard",
          "flags": "i"
        },
        {
          "source": "\\bgit\\s+clean\\b[^\\n]*-[a-z]*f",
          "flags": "i"
        },
        {
          "source": "\\bgit\\s+branch\\b[^\\n]*-D\\b",
          "flags": "i"
        },
        {
          "source": "\\bgit\\s+checkout\\b[^\\n]*--\\s+\\.",
          "flags": "i"
        },
        {
          "source": "\\bgit\\s+rebase\\b",
          "flags": "i"
        }
      ]
    },
    {
      "id": "write-system-path",
      "level": "high",
      "label": "写到系统目录",
      "labelEn": "Write into a system path",
      "zh": "目标落在操作系统目录里，不属于这个项目，出问题会影响别的程序。",
      "en": "The target is inside an operating-system folder, not this project. A mistake there affects other programs.",
      "tools": [
        "write",
        "edit",
        "write_file",
        "create_file",
        "append",
        "patch",
        "MultiEdit"
      ],
      "patterns": [
        {
          "source": "[a-z]:\\\\windows(\\\\|$)",
          "flags": "i"
        },
        {
          "source": "[a-z]:\\\\program files( \\(x86\\))?(\\\\|$)",
          "flags": "i"
        },
        {
          "source": "\\/(etc|usr|bin|sbin|boot|sys|proc)\\/",
          "flags": "i"
        }
      ]
    },
    {
      "id": "dependency-install",
      "level": "medium",
      "label": "安装 / 升级依赖",
      "labelEn": "Install or upgrade dependencies",
      "zh": "这会改动依赖树并写入磁盘；锁文件会变，别人拉下来可能装出不一样的版本。",
      "en": "This changes the dependency tree and writes to disk; the lockfile changes, so someone else may install different versions.",
      "patterns": [
        {
          "source": "\\b(npm|pnpm|yarn)\\s+(i|install|add|update|upgrade)\\b",
          "flags": "i"
        },
        {
          "source": "\\b(pip|pip3)\\s+install\\b",
          "flags": "i"
        },
        {
          "source": "\\buv\\s+(add|pip\\s+install|sync)\\b",
          "flags": "i"
        },
        {
          "source": "\\b(apt|apt-get|dnf|yum|brew)\\s+(install|upgrade)\\b",
          "flags": "i"
        },
        {
          "source": "\\b(winget|choco|scoop)\\s+(install|upgrade)\\b",
          "flags": "i"
        }
      ]
    },
    {
      "id": "service-stop",
      "level": "medium",
      "label": "停止服务 / 杀进程",
      "labelEn": "Stop a service or kill a process",
      "zh": "这会中断正在跑的东西；如果它正被别的任务依赖，那些任务会跟着失败。",
      "en": "This interrupts something that is running. Anything depending on it will fail too.",
      "patterns": [
        {
          "source": "\\bStop-Process\\b",
          "flags": "i"
        },
        {
          "source": "\\bStop-Service\\b",
          "flags": "i"
        },
        {
          "source": "\\bkill\\b[^\\n]*-?9",
          "flags": "i"
        },
        {
          "source": "\\btaskkill\\b",
          "flags": "i"
        },
        {
          "source": "\\bsystemctl\\s+(stop|disable)\\b",
          "flags": "i"
        },
        {
          "source": "\\bnet\\s+stop\\b",
          "flags": "i"
        },
        {
          "source": "\\bsc\\s+stop\\b",
          "flags": "i"
        },
        {
          "source": "\\bpkill\\b",
          "flags": "i"
        }
      ]
    },
    {
      "id": "network-outbound",
      "level": "medium",
      "label": "向外部发送数据",
      "labelEn": "Send data out",
      "zh": "这条命令会连到外部地址；如果带了文件或参数，内容可能被发出去。",
      "en": "This connects to an outside address. If it carries a file or payload, that content leaves the machine.",
      "patterns": [
        {
          "source": "\\bcurl\\b[^\\n]*(-d|--data|-F|--form|-T|--upload-file)\\b",
          "flags": "i"
        },
        {
          "source": "\\bcurl\\b[^\\n]*-X\\s*(POST|PUT|PATCH|DELETE)\\b",
          "flags": "i"
        },
        {
          "source": "\\bInvoke-(WebRequest|RestMethod)\\b[^\\n]*-(Method\\s+)?(Post|Put|Patch|Delete)\\b",
          "flags": "i"
        },
        {
          "source": "\\b(ssh|scp|rsync)\\b",
          "flags": "i"
        },
        {
          "source": "\\bnc\\s+-",
          "flags": "i"
        },
        {
          "source": "\\bftp\\b",
          "flags": "i"
        }
      ]
    },
    {
      "id": "in-place-overwrite",
      "level": "medium",
      "label": "覆盖写入已有文件",
      "labelEn": "Overwrite an existing file",
      "zh": "整份覆盖会把原来的内容替换掉，不像追加那样还能看出改了什么。",
      "en": "A full overwrite replaces the old content. Unlike an append, the previous version is no longer visible in the diff.",
      "tools": [
        "write",
        "write_file",
        "create_file"
      ],
      "patterns": [],
      "always": true,
      "quiet": true
    }
  ]
}
